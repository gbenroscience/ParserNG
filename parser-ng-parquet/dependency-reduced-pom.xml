<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <artifactId>parser-ng-parent</artifactId>
    <groupId>com.github.gbenroscience</groupId>
    <version>3.0.8</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>parser-ng-parquet</artifactId>
  <name>parser-ng-parquet</name>
  <version>3.0.8</version>
  <description>ParserNG's Parquet storage layer: projection, predicate-driven row-group pruning and
        allocation-conscious decoding into Apache Arrow VectorSchemaRoot batches.
        SQL-agnostic and execution-agnostic: it neither parses SQL nor evaluates expressions.</description>
  <url>https://github.com/gbenroscience/ParserNG</url>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <compilerArgs>
            <arg>--add-modules</arg>
            <arg>jdk.incubator.vector</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>org.openjdk.jmh</groupId>
              <artifactId>jmh-generator-annprocess</artifactId>
              <version>${jmh.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.3.1</version>
        <configuration>
          <argLine>--add-modules=jdk.incubator.vector
                        --enable-native-access=ALL-UNNAMED
                        --add-opens=java.base/java.nio=ALL-UNNAMED
                        --add-opens=java.base/java.util=ALL-UNNAMED
                        --add-opens=java.base/java.lang=ALL-UNNAMED
                        -Dio.netty.tryReflectionSetAccessible=true
                        -Darrow.allocation.manager.type=Netty</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <configuration>
          <executable>java</executable>
          <longModulepath>false</longModulepath>
          <arguments>
            <argument>--add-modules=jdk.incubator.vector</argument>
            <argument>--enable-native-access=ALL-UNNAMED</argument>
            <argument>-classpath</argument>
            <classpath />
            <argument>${exec.mainClass}</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>jmh</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-shade-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <phase>package</phase>
                <goals>
                  <goal>shade</goal>
                </goals>
                <configuration>
                  <finalName>benchmarks</finalName>
                  <transformers>
                    <transformer>
                      <mainClass>org.openjdk.jmh.Main</mainClass>
                    </transformer>
                  </transformers>
                  <filters>
                    <filter>
                      <artifact>*:*</artifact>
                      <excludes>
                        <exclude>META-INF/*.SF</exclude>
                        <exclude>META-INF/*.DSA</exclude>
                        <exclude>META-INF/*.RSA</exclude>
                      </excludes>
                    </filter>
                  </filters>
                  <artifactSet>
                    <includes>
                      <include>org.openjdk.jmh:jmh-core</include>
                      <include>org.openjdk.jmh:jmh-generator-annprocess</include>
                      <include>*:*</include>
                    </includes>
                  </artifactSet>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
      <dependencies>
        <dependency>
          <groupId>org.openjdk.jmh</groupId>
          <artifactId>jmh-core</artifactId>
          <version>${jmh.version}</version>
        </dependency>
        <dependency>
          <groupId>org.openjdk.jmh</groupId>
          <artifactId>jmh-generator-annprocess</artifactId>
          <version>${jmh.version}</version>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
  <dependencies>
    <dependency>
      <groupId>com.github.gbenroscience</groupId>
      <artifactId>parser-ng-sql</artifactId>
      <version>3.0.8</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>parser-ng</artifactId>
          <groupId>com.github.gbenroscience</groupId>
        </exclusion>
        <exclusion>
          <artifactId>parser-ng-simd</artifactId>
          <groupId>com.github.gbenroscience</groupId>
        </exclusion>
        <exclusion>
          <artifactId>parser-ng-gpu-simd</artifactId>
          <groupId>com.github.gbenroscience</groupId>
        </exclusion>
        <exclusion>
          <artifactId>parser-ng-arrow</artifactId>
          <groupId>com.github.gbenroscience</groupId>
        </exclusion>
        <exclusion>
          <artifactId>parser-ng-parquet</artifactId>
          <groupId>com.github.gbenroscience</groupId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.3</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>junit-jupiter-api</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
        <exclusion>
          <artifactId>junit-jupiter-params</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
        <exclusion>
          <artifactId>junit-jupiter-engine</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
  <properties>
    <maven.compiler.release>22</maven.compiler.release>
    <jmh.version>1.37</jmh.version>
    <exec.mainClass>com.github.gbenroscience.parser.ng.parquet.ParserNgParquet</exec.mainClass>
    <maven.compiler.target>22</maven.compiler.target>
    <maven.compiler.source>22</maven.compiler.source>
    <arrow.version>19.0.0</arrow.version>
    <parquet.version>1.18.0</parquet.version>
    <hadoop.version>3.4.1</hadoop.version>
  </properties>
</project>
