<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.github.gbenroscience</groupId>
        <artifactId>parser-ng-parent</artifactId>
        <version>3.0.9</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>parser-ng-parquet</artifactId>
    <packaging>jar</packaging>
    <name>parser-ng-parquet</name>
    <version>3.0.9</version>
    <description>
        ParserNG's Parquet storage layer: projection, predicate-driven row-group pruning and
        allocation-conscious decoding into Apache Arrow VectorSchemaRoot batches.
        SQL-agnostic and execution-agnostic: it neither parses SQL nor evaluates expressions.
    </description>
    <url>https://github.com/gbenroscience/ParserNG</url>

    <properties>
        <exec.mainClass>com.github.gbenroscience.parser.ng.parquet.ParserNgParquet</exec.mainClass>
        <maven.compiler.release>22</maven.compiler.release>
        <maven.compiler.source>22</maven.compiler.source>
        <maven.compiler.target>22</maven.compiler.target> 
        <!-- Keep in lock-step with parser-ng-arrow so both modules share one Arrow runtime. -->
        <arrow.version>19.0.0</arrow.version>
        <!-- Latest parquet-java at time of writing (Aug 2026). Re-verify before release. -->
        <parquet.version>1.18.0</parquet.version>
        <!-- parquet-hadoop needs Hadoop's Configuration/codec classes at runtime. VERIFY this pin. -->
        <hadoop.version>3.4.1</hadoop.version>
        <!-- JMH: keep core and the annotation processor in lock-step. -->
        <jmh.version>1.37</jmh.version>

    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-vector</artifactId>
            <version>${arrow.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-memory-netty</artifactId>
            <version>${arrow.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.parquet</groupId>
            <artifactId>parquet-hadoop</artifactId>
            <version>${parquet.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-client-api</artifactId>
            <version>${hadoop.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-client-runtime</artifactId>
            <version>${hadoop.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
          JMH for DecodeJmhBenchmark. "provided": needed to compile/run the benchmark class (which
          lives in src/main/java alongside DecodeBenchmark, matching this module's existing
          convention) without being pulled in as a runtime dependency of consumers of this jar.
        -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>provided</scope>
        </dependency>

<!--         Test only: the SQL/Arrow modules are NEVER a compile dependency of this module. 
        <dependency>
            <groupId>com.github.gbenroscience</groupId>
            <artifactId>parser-ng-sql</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>-->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <!-- FIX: Enable the vector API module for source compilation -->
                    <compilerArgs>
                        <arg>--add-modules</arg>
                        <arg>jdk.incubator.vector</arg>
                    </compilerArgs>
                    <!--
                      Explicit annotation processor path for JMH's @Benchmark code generator.
                      Without this, DecodeJmhBenchmark compiles but JMH's Runner/Main can't find
                      the generated *_jmhType/*_jmhTest classes at run time.
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <!-- Same flags as parser-ng-arrow so the SQL integration test can run. -->
                    <argLine>
                        --add-modules=jdk.incubator.vector
                        --enable-native-access=ALL-UNNAMED
                        --add-opens=java.base/java.nio=ALL-UNNAMED
                        --add-opens=java.base/java.util=ALL-UNNAMED
                        --add-opens=java.base/java.lang=ALL-UNNAMED
                        -Dio.netty.tryReflectionSetAccessible=true
                        -Darrow.allocation.manager.type=Netty
                    </argLine>
                    <!-- REMOVED: compilerArgs from surefire plugin (invalid tag here) -->
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <executable>java</executable>
                    <longModulepath>false</longModulepath>
                    <arguments>
                        <!-- This forces Maven to feed the incubator flags to the JVM on Shift+F6 -->
                        <argument>--add-modules=jdk.incubator.vector</argument>
                        <argument>--enable-native-access=ALL-UNNAMED</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>${exec.mainClass}</argument>
                    </arguments>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <profiles>
       
        <profile>
            <id>jmh</id>
            <dependencies>
                <!-- Force JMH onto the compile/runtime classpath for the shade step -->
                <dependency>
                    <groupId>org.openjdk.jmh</groupId>
                    <artifactId>jmh-core</artifactId>
                    <version>${jmh.version}</version>
                </dependency>
                <dependency>
                    <groupId>org.openjdk.jmh</groupId>
                    <artifactId>jmh-generator-annprocess</artifactId>
                    <version>${jmh.version}</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <finalName>benchmarks</finalName>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                            <mainClass>org.openjdk.jmh.Main</mainClass>
                                        </transformer>
                                    </transformers>
                                    <filters>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                    <!-- Make sure JMH is included even if it was provided in the main dependencies -->
                                    <artifactSet>
                                        <includes>
                                            <include>org.openjdk.jmh:jmh-core</include>
                                            <include>org.openjdk.jmh:jmh-generator-annprocess</include>
                                            <include>*:*</include> <!-- keep everything else -->
                                        </includes>
                                    </artifactSet>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>